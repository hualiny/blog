---
import type { ImageMetadata } from 'astro'
import type { HTMLTag, Polymorphic } from 'astro/types'

import { cn } from 'astro-pure/utils'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  heading: string
  subheading: string
  imagePath?: string
  altText?: string
  href?: string
  class?: string
}

const {
  as: Tag = 'a',
  class: className,
  href,
  heading,
  subheading,
  imagePath,
  altText
} = Astro.props

// 图片变为可选
let image = null
if (imagePath) {
  const images = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}'
  )
  const imageModule = images[imagePath]
  if (imageModule) {
    image = await imageModule()
  }
}
---

<Tag
  class={cn(
    className,
    'group block rounded-2xl border bg-card p-8 transition-all hover:border-primary hover:shadow-lg h-full relative'
  )}
  href={href}
>
  <div class="flex items-start justify-between h-full">
    <div class="flex-1">
      <div class="flex items-center gap-3 mb-3">
        <div class="size-6 text-primary">📁</div>
        <h2 class="text-2xl font-medium group-hover:text-primary transition-colors">
          {heading}
        </h2>
      </div>
      <p class="text-muted-foreground mb-6">
        {subheading}
      </p>
    </div>
    
    {image && (
      <div class="ml-4 w-20 h-20 rounded-xl overflow-hidden flex-shrink-0 opacity-80">
        <img 
          src={image.default.src} 
          alt={altText ?? heading}
          class="w-full h-full object-cover"
        />
      </div>
    )}
  </div>

  <!-- 移到右下角 -->
  <div class="absolute bottom-6 right-6 text-sm text-muted-foreground flex items-center gap-1 opacity-70 group-hover:opacity-100 transition-opacity">
    点击查看全部文章
    <span class="text-base">→</span>
  </div>
</Tag>

